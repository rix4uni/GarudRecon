# Port Scanning
MONITOR_PORTS(){
	# Detect input type
	local input_info=$(_detect_input_type "$TARGET")
	local input_type=$(echo "$input_info" | cut -d'|' -f1)
	local input_source=$(echo "$input_info" | cut -d'|' -f2)
	local base_name=$(basename "$TARGET" .txt 2>/dev/null || echo "$TARGET")
	base_name=$(basename "$base_name" .subs 2>/dev/null || echo "$base_name")
	
	# Run prerequisite functions WITHOUT starting MONITOR_PORTS spinner yet
	# If domain provided, check if subdomains file exists first
	if [[ "$input_type" == "domain" ]]; then
		echo -e "${YELLOW}[~] Domain detected: ${TARGET}${RESET}"
		# Check if subdomains file already exists
		if [[ -s "${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs" ]]; then
			echo -e "${YELLOW}[~] Using existing subdomains file: ${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs${RESET}"
			input_source="${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs"
			input_type="subdomains"
			base_name="$TARGET"
		else
			echo -e "${YELLOW}[~] Subdomains file not found, running MONITOR_SUBDOMAIN first...${RESET}"
			MONITOR_SUBDOMAIN
			input_source="${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs"
			input_type="subdomains"
			base_name="$TARGET"
		fi
	fi
	
	# Now start MONITOR_PORTS spinner - only when we're actually doing MONITOR_PORTS work
	START_SPINNER "${BGREEN}MONITOR_PORTS${RESET}"

	# Determine output file
	local output_file="${CRONJOBS_PORTSIR}/${base_name}.naabu"
	local new_output_file="${CRONJOBS_PORTSIR}/${base_name}-new.naabu"
	
	echo -e "Saving file in ${output_file}"
	
	# Get input data
	local input_data=""
	case "$input_type" in
		"subdomains")
			input_data=$(cat "$input_source")
			;;
		*)
			# Fallback: use subdomains file
			if [[ -f "${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs" ]]; then
				input_data=$(cat "${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs")
			else
				echo -e "${BRED}[x] MONITOR_PORTS - ERROR: No valid input source found${RESET}"
				STOP_SPINNER
				return
			fi
			;;
	esac
	
	# Process port scanning
	if [[ ! -s "${output_file}" ]]; then
		echo "$input_data" | naabu -duc -silent -c ${NAABU_THREADS} -rate ${NAABU_RATELIMIT} -timeout ${NAABU_TIMEOUT} -retries ${NAABU_RETRIES} -top-ports 1000 2>/dev/null | unew -ef -el -i -t -q "${output_file}"
	else
		echo "$input_data" | naabu -duc -silent -c ${NAABU_THREADS} -rate ${NAABU_RATELIMIT} -timeout ${NAABU_TIMEOUT} -retries ${NAABU_RETRIES} -top-ports 1000 2>/dev/null | unew -ef -el -i -t "${output_file}" | unew -ef -el -i -t "${new_output_file}" | notify -silent -duc -bulk -id ${PORTS_NOTIFY} &>/dev/null
	fi
	
	# Clean up temp file if created
	if [[ -n "$input_source" ]] && [[ "$input_source" =~ ^/tmp/ ]]; then
		rm -f "$input_source" 2>/dev/null
	fi

	STOP_SPINNER
	if [[ "$VERBOSE" == true ]]; then
	  echo -e "${BGREEN}[+] MONITOR_PORTS${RESET}\n  ├─ Input type     : ${input_type}\n  ├─ All ports      : $(wc -l 2>/dev/null < "${output_file}" || echo 0)\n  ├─ New ports      : $(wc -l 2>/dev/null < "${new_output_file}" || echo 0)\n  └─ Time taken     : ${TIME} seconds"
	else
	  echo -e "${BGREEN}[+] MONITOR_PORTS${RESET}: Input type: ${input_type}, All ports: $(wc -l 2>/dev/null < "${output_file}" || echo 0), New ports: $(wc -l 2>/dev/null < "${new_output_file}" || echo 0), Time taken: ${TIME} seconds"
	fi
