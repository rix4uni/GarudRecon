#!/bin/bash

# Default config file path
CONFIG_PATH="configuration/garudrecon_max.cfg"

TARGET=""

VERBOSE=false
CRONJOBS_SLEEP_INTERVAL=3600  # default: 1 hour

# Help function
function show_help() {
  cat <<EOF
Schedule and monitor recurring recon tasks (subdomains, open ports, JS leaks, templates, alerts).
Run continuous monitoring: periodic scans, delta detection, and notifications when new assets or issues appear.

Usage:
  garudrecon cronjobs [flags]

Flags:
  -d, --domain			Domain to monitor
  -f, --function		Function to run (e.g. MONITOR_SUBDOMAIN)
  -c, --config   		Custom configuration file path
  -i, --interval		Customize the sleep duration (e.g. 1800)
  -v, --verbose 		enable verbose mode
  -h, --help   			help for cronjobs

Example:
  garudrecon cronjobs -d domain.com -f MONITOR_SUBDOMAIN
  garudrecon cronjobs -d domain.com -f MONITOR_PORTS
  garudrecon cronjobs -d domain.com -f MONITOR_ALIVESUBD
  garudrecon cronjobs -d domain.com -f MONITOR_JS
  garudrecon cronjobs -d domain.com -f MONITOR_JSLEAKS
EOF
}

# Check if no args
if [[ $# -eq 0 ]]; then
  show_help
  exit 0
fi

# Parse arguments
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -d|--domain)
      TARGET="$2"
      shift 2
      ;;
    -f|--function)
    	if [[ -z "$2" || "$2" == -* ]]; then
		      echo "Error: -f requires a valid function argument"
		      exit 1
		  fi

      FUNC="$2"
      shift 2
      ;;
    -i|--interval)
		  CRONJOBS_SLEEP_INTERVAL="$2"
		  shift 2
		  ;;
    -c|--config)
      CONFIG_PATH="$2"
      shift 2
      ;;
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

# Escape dots in domain for regex
ESCAPED_TARGET=$(echo "$TARGET" | sed 's/\./\\./g')

if [[ -z "$TARGET" ]]; then
    echo "Error: Target domain is required. Use -d <domain>"
    exit 1
fi

# Load configuration
if [[ -f "$CONFIG_PATH" ]]; then
    source "$CONFIG_PATH"
else
    echo "Error: Configuration file '$CONFIG_PATH' not found."
    exit 1
fi

PRINTBANNER

# Check root user
AREUROOTUSER

# Base directory
BASEDIR="cronjobscan"

# Subdirectories within cronjobscan
CRONJOBS_SUBDOMAINDIR="$BASEDIR/subdomain"
CRONJOBS_PORTSIR="$BASEDIR/ports"
CRONJOBS_ALIVE_SUBDOMAINDIR="$BASEDIR/alivesubdomain"
CRONJOBS_JSDIR="$BASEDIR/javascript"
CRONJOBS_JSLEAKSDIR="$BASEDIR/javascriptleaks"

# Creating directories
mkdir -p "$CRONJOBS_SUBDOMAINDIR"
mkdir -p "$CRONJOBS_PORTSIR"
mkdir -p "$CRONJOBS_ALIVE_SUBDOMAINDIR"
mkdir -p "$CRONJOBS_JSDIR"
mkdir -p "$CRONJOBS_JSLEAKSDIR"

# Function to handle CLEANUP on Ctrl+C
CLEANUP(){
    if [[ -n "$SPINNER_PID" ]]; then
        kill "$SPINNER_PID" 2>/dev/null
    fi
    exit 1
}
trap CLEANUP SIGINT

START_SPINNER(){
    processing="${1}"
    START_TIME=$(date +%s)
    BRAILLE_STYLE_SPINNER_CHARS=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    # SLASH_SPINNER_CHARS=("/" "-" "\\" "|")
    # ARC_SPINNER_CHARS=("◐" "◓" "◑" "◒")
    # CLASSIC_DOTS_SPINNER_CHARS=("⠂" "⠒" "⠐" "⠰" "⠴" "⠦" "⠖" "⠒")
    # ARROW_SPINNER_CHARS=("←" "↖" "↑" "↗" "→" "↘" "↓" "↙")
    # BOX_SPINNER_CHARS=("▖" "▘" "▝" "▗")
    # QUARTERS_SPINNER_CHARS=("◴" "◷" "◶" "◵")
    # CLOCK_SPINNER_CHARS=("🕛" "🕐" "🕑" "🕒" "🕓" "🕔" "🕕" "🕖" "🕗" "🕘" "🕙" "🕚")
    # EMOJI_SPINNER_CHARS=("🌑" "🌒" "🌓" "🌔" "🌕" "🌖" "🌗" "🌘")
    # TRAIL_SPINNER_CHARS=("⠁" "⠂" "⠄" "⠂")

    while true; do
    	ELAPSED=$(( $(date +%s) - START_TIME ))
        for char in "${BRAILLE_STYLE_SPINNER_CHARS[@]}"; do
            printf "${YELLOW}[${char}]${RESET} ${processing} ${CYAN}(${ELAPSED} seconds)${RESET} 🔎"
            printf "                                    \r"
            sleep 0.05
        done
    done &
    SPINNER_PID=$!
}

STOP_SPINNER(){
    kill "${SPINNER_PID}" 2>/dev/null
    TIME=$(( $(date +%s) - START_TIME ))
    return $TIME
}

echo -e "Using $CONFIG_PATH"


