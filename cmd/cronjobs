				;;
		esac
		
		# Fallback to base_name if extraction failed
		if [[ -z "$filter_domain" ]] || [[ "$filter_domain" == "." ]]; then
			filter_domain="$base_name"
		fi
		ESCAPED_TARGET=$(echo "$filter_domain" | sed 's/\./\\./g')
	fi
	
	# Process input data based on detected type
	local input_data=""
	case "$input_type" in
		"urls"|"alive_subs")
			# URLs or alive subdomains - extract URLs (first column)
			input_data=$(cat "$input_source" | awk '{print $1}')
			;;
		"subdomains")
			# Subdomains - convert to URLs (assume https)
			input_data=$(cat "$input_source" | sed 's|^|https://|')
			;;
		*)
			# Fallback: try to use alive subdomains file
			if [[ -f "${CRONJOBS_ALIVE_SUBDOMAINDIR}/${TARGET}.alivesubs" ]]; then
				input_data=$(cat "${CRONJOBS_ALIVE_SUBDOMAINDIR}/${TARGET}.alivesubs" | awk '{print $1}')
			else
				echo -e "${BRED}[x] MONITOR_JS - ERROR: No valid input source found${RESET}"
				STOP_SPINNER
				return
			fi
			;;
	esac
	
	# Process JS extraction with domain filtering
	if [[ ! -s "${output_file}" ]]; then
		echo "$input_data" | subjs | grep -aE "(https?://${ESCAPED_TARGET}(:[0-9]+)?(/)|\.${ESCAPED_TARGET}[:/])" | unew -ef -el -i -t -q "${output_file}"
	else
		echo "$input_data" | subjs | grep -aE "(https?://${ESCAPED_TARGET}(:[0-9]+)?(/)|\.${ESCAPED_TARGET}[:/])" | unew -ef -el -i -t "${output_file}" | unew -ef -el -i -t "${new_output_file}" | notify -silent -duc -bulk -id ${JAVASCRIPT_NOTIFY} &>/dev/null
	fi
	
	# Clean up temp file if created
	if [[ -n "$input_source" ]] && [[ "$input_source" =~ ^/tmp/ ]]; then
		rm -f "$input_source" 2>/dev/null
	fi

	STOP_SPINNER
	if [[ "$VERBOSE" == true ]]; then
	  echo -e "${BGREEN}[+] MONITOR_JS${RESET}\n  ├─ Input type     : ${input_type}\n  ├─ All js         : $(wc -l 2>/dev/null < "${output_file}" || echo 0)\n  ├─ New js         : $(wc -l 2>/dev/null < "${new_output_file}" || echo 0)\n  └─ Time taken     : ${TIME} seconds"
	else
	  echo -e "${BGREEN}[+] MONITOR_JS${RESET}: Input type: ${input_type}, All js: $(wc -l 2>/dev/null < "${output_file}" || echo 0), New js: $(wc -l 2>/dev/null < "${new_output_file}" || echo 0), Time taken: ${TIME} seconds"
	fi
}


# Javascript Leaks Scanning
MONITOR_JSLEAKS(){
	# Detect input type
	local input_info=$(_detect_input_type "$TARGET")
	local input_type=$(echo "$input_info" | cut -d'|' -f1)
	local input_source=$(echo "$input_info" | cut -d'|' -f2)
	local base_name=$(basename "$TARGET" .txt 2>/dev/null || echo "$TARGET")
	base_name=$(basename "$base_name" .js 2>/dev/null || echo "$base_name")
	base_name=$(basename "$base_name" .alivesubs 2>/dev/null || echo "$base_name")
	base_name=$(basename "$base_name" .subs 2>/dev/null || echo "$base_name")
	
	# If domain provided, check if JS file exists first
	if [[ "$input_type" == "domain" ]]; then
		echo -e "${YELLOW}[~] Domain detected: ${TARGET}${RESET}"
		# Check if JS file already exists
		if [[ -s "${CRONJOBS_JSDIR}/${TARGET}.js" ]]; then
			echo -e "${YELLOW}[~] Using existing JS file: ${CRONJOBS_JSDIR}/${TARGET}.js${RESET}"
			input_source="${CRONJOBS_JSDIR}/${TARGET}.js"
			input_type="js"
			base_name="$TARGET"
		else
			# Check if alive subdomains file exists
			if [[ -s "${CRONJOBS_ALIVE_SUBDOMAINDIR}/${TARGET}.alivesubs" ]]; then
				echo -e "${YELLOW}[~] Using existing alive subdomains file, running MONITOR_JS...${RESET}"
				local original_target="$TARGET"
				TARGET="${CRONJOBS_ALIVE_SUBDOMAINDIR}/${TARGET}.alivesubs"
				MONITOR_JS
				TARGET="$original_target"
			else
				# Check if ports file exists
				if [[ -s "${CRONJOBS_PORTSIR}/${TARGET}.naabu" ]]; then
					echo -e "${YELLOW}[~] Using existing ports file, running MONITOR_ALIVESUBD → MONITOR_JS...${RESET}"
					local original_target="$TARGET"
					TARGET="${CRONJOBS_PORTSIR}/${TARGET}.naabu"
					MONITOR_ALIVESUBD
					TARGET="${CRONJOBS_ALIVE_SUBDOMAINDIR}/${original_target}.alivesubs"
					MONITOR_JS
					TARGET="$original_target"
				else
					# Check if subdomains file exists
					if [[ -s "${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs" ]]; then
						echo -e "${YELLOW}[~] Using existing subdomains file, running MONITOR_PORTS → MONITOR_ALIVESUBD → MONITOR_JS...${RESET}"
						local original_target="$TARGET"
						TARGET="${CRONJOBS_SUBDOMAINDIR}/${TARGET}.subs"
						MONITOR_PORTS
						TARGET="${CRONJOBS_PORTSIR}/${original_target}.naabu"
						MONITOR_ALIVESUBD
						TARGET="${CRONJOBS_ALIVE_SUBDOMAINDIR}/${original_target}.alivesubs"
						MONITOR_JS
						TARGET="$original_target"
					else
						echo -e "${YELLOW}[~] Running full pipeline: MONITOR_SUBDOMAIN → MONITOR_PORTS → MONITOR_ALIVESUBD → MONITOR_JS${RESET}"
						MONITOR_SUBDOMAIN
						MONITOR_PORTS
						MONITOR_ALIVESUBD
						MONITOR_JS
					fi
				fi
			fi
			input_source="${CRONJOBS_JSDIR}/${TARGET}.js"
			input_type="js"
			base_name="$TARGET"
		fi
	# If subdomains/alive_subs/urls provided, check if JS file exists first
	elif [[ "$input_type" == "subdomains" ]] || [[ "$input_type" == "alive_subs" ]] || [[ "$input_type" == "urls" ]]; then
		echo -e "${YELLOW}[~] ${input_type} file detected${RESET}"
		# Check if JS file already exists for this base_name
		if [[ -s "${CRONJOBS_JSDIR}/${base_name}.js" ]]; then
			echo -e "${YELLOW}[~] Using existing JS file: ${CRONJOBS_JSDIR}/${base_name}.js${RESET}"
			input_source="${CRONJOBS_JSDIR}/${base_name}.js"
			input_type="js"
		else
			echo -e "${YELLOW}[~] JS file not found, running MONITOR_JS first...${RESET}"
			# Temporarily set TARGET to input_source for MONITOR_JS
			local original_target="$TARGET"
			TARGET="$input_source"
			MONITOR_JS
			TARGET="$original_target"
			input_source="${CRONJOBS_JSDIR}/${base_name}.js"
			input_type="js"
		fi
	fi
	
	# Now start MONITOR_JSLEAKS spinner - only when we're actually doing MONITOR_JSLEAKS work
	START_SPINNER "${BGREEN}MONITOR_JSLEAKS${RESET}"

	# Determine output file
	local output_file="${CRONJOBS_JSLEAKSDIR}/${base_name}.jsleaks"
	local new_output_file="${CRONJOBS_JSLEAKSDIR}/${base_name}-new.jsleaks"
	
	echo -e "Saving file in ${output_file}"
	
	# Get input data
	local input_data=""
	case "$input_type" in
		"js")
			input_data=$(cat "$input_source")
			;;
		*)
			# Fallback: use JS file
			if [[ -f "${CRONJOBS_JSDIR}/${TARGET}.js" ]]; then
				input_data=$(cat "${CRONJOBS_JSDIR}/${TARGET}.js")
			else
				echo -e "${BRED}[x] MONITOR_JSLEAKS - ERROR: No valid input source found${RESET}"
				STOP_SPINNER
				return
			fi
			;;
	esac
	
	# Process JS leaks scanning
	if [[ ! -s "${output_file}" ]]; then
		echo "$input_data" | egrep -av "\.json" | grep -a "\.js" | linkinspector -silent -nc -mt "application/javascript" | awk '{print $1}' | unew -ef -el -i -t -q "${output_file}"
		echo "$input_data" | nuclei -duc -silent -nc -t ~/nuclei-templates/exposures/ | unew -ef -el -i -t -q "${output_file}"
	else
		echo "$input_data" | egrep -av "\.json" | grep -a "\.js" | linkinspector -silent -nc -mt "application/javascript" | awk '{print $1}' | unew -ef -el -i -t "${output_file}" | unew -ef -el -i -t "${new_output_file}" | notify -silent -duc -bulk -id ${JAVASCRIPTLEAKS_NOTIFY} &>/dev/null
		echo "$input_data" | nuclei -duc -silent -nc -t ~/nuclei-templates/exposures/ | unew -ef -el -i -t "${output_file}" | unew -ef -el -i -t "${new_output_file}" | notify -silent -duc -bulk -id ${JAVASCRIPT_NOTIFY}leaks &>/dev/null
	fi
	
	# Clean up temp file if created
	if [[ -n "$input_source" ]] && [[ "$input_source" =~ ^/tmp/ ]]; then
		rm -f "$input_source" 2>/dev/null
	fi

	STOP_SPINNER
	if [[ "$VERBOSE" == true ]]; then
	  echo -e "${BGREEN}[+] MONITOR_JSLEAKS${RESET}\n  ├─ Input type     : ${input_type}\n  ├─ All jsleaks    : $(wc -l 2>/dev/null < "${output_file}" || echo 0)\n  ├─ New jsleaks    : $(wc -l 2>/dev/null < "${new_output_file}" || echo 0)\n  └─ Time taken     : ${TIME} seconds"
	else
	  echo -e "${BGREEN}[+] MONITOR_JSLEAKS${RESET}: Input type: ${input_type}, All jsleaks: $(wc -l 2>/dev/null < "${output_file}" || echo 0), New jsleaks: $(wc -l 2>/dev/null < "${new_output_file}" || echo 0), Time taken: ${TIME} seconds"
	fi
}


