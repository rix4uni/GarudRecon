# Generic helper function to detect input type and get input source
# Returns: input_type|input_source
_detect_input_type() {
	local input="$1"
	local input_source=""
	local input_type=""
	
	# Check if input is a file
	if [[ -f "$input" ]]; then
		# Check if it's a URLs file (contains http:// or https://)
		if grep -qE "^https?://" "$input" 2>/dev/null; then
			input_type="urls"
			input_source="$input"
		# Check if it's an alive subdomains file (contains URLs with status codes, titles, etc.)
		elif grep -qE "^https?://.*\[.*\]" "$input" 2>/dev/null || grep -qE "^https?://.*\s+\[" "$input" 2>/dev/null; then
			input_type="alive_subs"
			input_source="$input"
		# Check if it's a ports file (contains IP:port or host:port)
		elif grep -qE ":[0-9]+$" "$input" 2>/dev/null; then
			input_type="ports"
			input_source="$input"
		# Check if it's a JS file (contains .js URLs)
		elif grep -qE "\.js" "$input" 2>/dev/null; then
			input_type="js"
			input_source="$input"
		# Check if it's a subdomains file (just domain names)
		elif grep -qE "^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$" "$input" 2>/dev/null; then
			input_type="subdomains"
			input_source="$input"
		else
			# Default: treat as subdomains file
			input_type="subdomains"
			input_source="$input"
		fi
	# Check if it's a domain (contains dots but no slashes, not a file)
	elif [[ "$input" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]] && [[ ! "$input" =~ / ]]; then
		input_type="domain"
		input_source=""
	# Check if it's a URL
	elif [[ "$input" =~ ^https?:// ]]; then
		input_type="urls"
		# Create temp file with single URL
		input_source=$(mktemp)
		echo "$input" > "$input_source"
	else
		# Default: treat as domain
		input_type="domain"
		input_source=""
	fi
	
	echo "$input_type|$input_source"
}

