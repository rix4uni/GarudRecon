while true; do
  # Dynamically run the selected monitoring function
  $FUNC
  
  echo -e "${BYELLOW}[i] Sleeping for $CRONJOBS_SLEEP_INTERVAL seconds before next run...${RESET}\n"

  sleep "$CRONJOBS_SLEEP_INTERVAL"
done