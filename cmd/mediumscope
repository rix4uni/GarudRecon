	if [ "$FFUFBRUTE_USE_CUSTOM_WORDLIST" = "TRUE" ]; then
		cat ${SUBDOMAINDIR}/withoutprotocolsubs.txt | tr '.-' '\n' | unew -el -i -t -q ${WORDLIST_BASEDIR}/perms.txt
