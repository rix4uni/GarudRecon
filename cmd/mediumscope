	timelimitx -t ${AMASS_TIMELIMITX} "amass enum -nocolor -nolocaldb -passive -norecursive -noalts -d ${TARGET} 2>/dev/null | unew -ef -el -i -t -q ${TMPDIR}/amass.subs"

	STOP_SPINNER
