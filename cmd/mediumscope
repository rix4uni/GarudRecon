GITHUB_SUBDOMAINS(){
	START_SPINNER "${BGREEN}GITHUB_SUBDOMAINS${RESET}"

	github-subdomains -d ${TARGET} -t ~/.config/github-subdomains/.github_tokens -o ${SUBDOMAINDIR}/tmp-github-subdomains.subs
