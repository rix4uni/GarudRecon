#!/bin/bash

# Default config file path
CONFIG_PATH="configuration/garudrecon.cfg"

TARGET=""
DOMAINS_LIST_FILE=""

EXCLUDE_FUNCS=()
RECON_SUBDOMAIN=false
RECON_SUBDOMAIN_URLS=false
RECON_XSS=false
RECON_SQLI=false
RECON_LFI=false
RECON_SUBTAKEOVER=false
RECON_RCE=false
RECON_IIS=false
ACTIVE_ENUM=false

# New variable
RESUME_MODE=false
RESUME_TARGET=""
VERBOSE=false

# Help function
function show_help() {
  cat <<EOF
Moderate recon for a wildcard domain (e.g. *.domain.com) with optional vuln checks.
Balanced scan depth: discovers subdomains, does basic service/port checks and optional lightweight vulnerability checks.

Usage:
  garudrecon mediumscope [flags]

Flags:
  -d, --domain				Scan a domain (e.g. domain.com)
  -dL, --domains-list			Scan multiple domains from a file (e.g. targets.txt)
  -ef, --exclude-functions		Exclude a function from running (e.g. AMASS)
  -s, --recon-subdomain			Run Subdomain Enumeration only
  -a, --active				Run Active Subdomain Enumeration also (e.g. puredns, altdns)
  -su, --recon-subdomainurls		Run Subdomain Enumeration + Url Crawling only
  -rx, --recon-xss			Run full recon with XSS checks
  -rs, --recon-sqli			Run full recon with SQLi checks
  -rl, --recon-lfi			Run full recon with LFI checks
  -rst, --recon-subtakeover		Run full recon with Subdomain Takeover checks
  -rr, --recon-rce 	   		Run full recon with RCE checks
  -ri, --recon-iis 	   		Run full recon with IIS checks
  -oos, --outofscope			Exclude outofscope subdomains from a list (e.g. domain.com.oos)
  -c, --config				Custom configuration file path
  -r, --resume <scan_folder>   		Resume stopped/uncompleted scan from /root/.garudrecon/scans/<scan_folder> (e.g., --resume domain.com or --resume domain.com_1). Skips functions already completed in resume.cfg.
  -v, --verbose				Show file paths where scan results are saved
  -h, --help				help for mediumscope

Example:
# Full recon with all vulnerability scan
  garudrecon mediumscope -d domain.com

# Scan multiple domains from a file
  garudrecon mediumscope -dL targets.txt

# Recon Subdomain Enumeration only
garudrecon mediumscope -d domain.com -s

# Run Active Subdomain Enumeration also (e.g. puredns, altdns)
  garudrecon mediumscope -d domain.com -s -a

# Recon Subdomain Enumeration + Url Crawling only
  garudrecon mediumscope -d domain.com -su

# Recon with XSS only
  garudrecon mediumscope -d domain.com -rx

# Recon with SQLi only
  garudrecon mediumscope -d domain.com -rs

# Exclude functions manually
  garudrecon mediumscope -d domain.com -ef "SUBFINDER,AMASS"

# Combined
  garudrecon mediumscope -d domain.com -rx -ef "AMASS"

# Skips functions already completed in resume.cfg.
  garudrecon mediumscope -d domain.com -rx --resume domain.com_1
EOF
}

# Check if no args
if [[ $# -eq 0 ]]; then
  show_help
  exit 0
fi

# Parse arguments
USER_EXCLUDES=()
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -d|--domain)
            TARGET="$2"
            shift 2
            ;;
        -dL|--domains-list)
            DOMAINS_LIST_FILE="$2"
            shift 2
            ;;
        -ef|--exclude-functions)
            IFS=',' read -ra raw_funcs <<< "$2"
            for func in "${raw_funcs[@]}"; do
                trimmed_func=$(echo "$func" | xargs)
                USER_EXCLUDES+=("$trimmed_func")
            done
            shift 2
            ;;
	    -s|--recon-subdomain)
	        RECON_SUBDOMAIN=true
	        shift
	        ;;
        -a|--active)
            ACTIVE_ENUM=true
            shift
            ;;
	    -su|--recon-subdomainurls)
	        RECON_SUBDOMAIN_URLS=true
	        shift
	        ;;
	    -rx|--recon-xss)
	        RECON_XSS=true
	        shift
	        ;;
	    -rs|--recon-sqli)
	        RECON_SQLI=true
	        shift
	        ;;
	    -rl|--recon-lfi)
	        RECON_LFI=true
	        shift
	        ;;
	    -rst|--recon-subtakeover)
	        RECON_SUBTAKEOVER=true
	        shift
	        ;;
	    -rr|--recon-rce)
	        RECON_RCE=true
	        shift
	        ;;
	    -ri|--recon-iis)
	        RECON_IIS=true
	        shift
	        ;;
        -oos|--outofscope)
		    if [[ -z "$2" || "$2" == -* ]]; then
		        echo "Error: -oos requires a valid filename argument"
		        exit 1
		    fi

		    if [[ ! -s "$2" || ! -f "$2" ]]; then
		        echo "Error: OOS file '$2' does not exist or is empty"
		        exit 1
		    fi

		    OOS_FILE="$2"
		    shift 2
		    ;;
        -c|--config)
            CONFIG_PATH="$2"
            shift 2
            ;;
	-r|--resume)
            RESUME_MODE=true
            RESUME_TARGET="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
	        show_help
	        exit 0
	        ;;
        *)
            echo "Unknown option: $1"
            exit 1
            ;;
    esac
done

# Validate that both -d and -dL are not used together
if [[ -n "$TARGET" && -n "$DOMAINS_LIST_FILE" ]]; then
    echo "Error: Cannot use both -d and -dL flags together. Use either -d <domain> or -dL <file>"
    exit 1
fi

# Validate domains list file if -dL is used
if [[ -n "$DOMAINS_LIST_FILE" ]]; then
    if [[ ! -f "$DOMAINS_LIST_FILE" ]]; then
        echo "Error: Domains list file '$DOMAINS_LIST_FILE' does not exist"
        exit 1
    fi
    if [[ ! -r "$DOMAINS_LIST_FILE" ]]; then
        echo "Error: Domains list file '$DOMAINS_LIST_FILE' is not readable"
        exit 1
    fi
    if [[ ! -s "$DOMAINS_LIST_FILE" ]]; then
        echo "Error: Domains list file '$DOMAINS_LIST_FILE' is empty"
        exit 1
    fi
    # Resume mode doesn't work with domain list
    if [[ "$RESUME_MODE" == true ]]; then
        echo "Error: -r|--resume flag cannot be used with -dL|--domains-list"
        exit 1
    fi
fi

# Validate single domain if -d is used (without -dL)
if [[ -z "$DOMAINS_LIST_FILE" && -z "$TARGET" && "$RESUME_MODE" == false ]]; then
    echo "Error: Target domain is required. Use -d <domain> or -dL <file>"
    exit 1
fi

# Load configuration - check both possible locations
if [[ -f "$CONFIG_PATH" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_PATH"
elif [[ -f "$HOME/.garudrecon/configuration/garudrecon.cfg" ]]; then
    # shellcheck disable=SC1090
    source "$HOME/.garudrecon/configuration/garudrecon.cfg"
else
    echo "Error: Configuration file '$CONFIG_PATH' not found."
    exit 1
fi

# Initialize with defaults from config
if [[ ${#DEFAULT_EXCLUDE_FUNCS[@]} -gt 0 ]]; then
    EXCLUDE_FUNCS=("${DEFAULT_EXCLUDE_FUNCS[@]}")
fi

# Merge user excludes on top
EXCLUDE_FUNCS+=("${USER_EXCLUDES[@]}")

PRINTBANNER

# Check root user
AREUROOTUSER

# Base directory
BASEDIR="scans"

# Function to process a single domain
process_domain() {
    local domain="$1"
    
    # Set TARGET and ESCAPED_TARGET for this domain
    TARGET="$domain"
    ESCAPED_TARGET=$(echo "$TARGET" | sed 's/\./\\./g')
    
    # Track completed functions from resume.cfg
    COMPLETED_FUNCS=()
    
    if [[ "$RESUME_MODE" == true ]]; then
        UNIQUEDOMAINDIR="$BASEDIR/$RESUME_TARGET"
        RESUMELOGFILE="$UNIQUEDOMAINDIR/resume.cfg"
        if [[ -f "$RESUMELOGFILE" ]]; then
            # Remove colors, remove everything after colon, then extract function name
            mapfile -t COMPLETED_FUNCS < <(sed 's/\x1b\[[0-9;]*m//g' "$RESUMELOGFILE" | cut -d':' -f1 | awk '{print $2}')
        else
            echo "Error: Resume file '$RESUMELOGFILE' not found."
            exit 1
        fi

        # Use these variables in RESUME_MODE also
        TMPDIR="$UNIQUEDOMAINDIR/.tmp"

        ERRORLOGFILE="$UNIQUEDOMAINDIR/error.log"
        RESUMELOGFILE="$UNIQUEDOMAINDIR/resume.cfg"
else
	# Function to generate a unique directory name
	generate_unique_dir(){
	    local dir_path="$BASEDIR/$TARGET"
	    local counter=1
	    
	    while [ -d "$dir_path" ]; do
	        dir_path="$BASEDIR/${TARGET}_$counter"
	        ((counter++))
	    done

	    echo "$dir_path"
	}

	# Generate unique domain directory
	UNIQUEDOMAINDIR=$(generate_unique_dir)
	TMPDIR="$UNIQUEDOMAINDIR/.tmp"

	ERRORLOGFILE="$UNIQUEDOMAINDIR/error.log"
	RESUMELOGFILE="$UNIQUEDOMAINDIR/resume.cfg"


	# Creating directories
	# Subdirectories within .tmp
	mkdir -p "$UNIQUEDOMAINDIR"
	mkdir -p "$TMPDIR"
fi

# Creating files
touch "$TMPDIR/crunchbase.txt"
touch "$TMPDIR/manual_google_dorking.urls"
touch "$TMPDIR/burpsuite.urls"

# Utility function to check if a function is excluded or already completed
is_excluded() {
    local func="$1"
    for excluded in "${EXCLUDE_FUNCS[@]}"; do
        if [[ "$excluded" == "$func" ]]; then
            return 0
        fi
    done
    for done_func in "${COMPLETED_FUNCS[@]}"; do
        if [[ "$done_func" == "$func" ]]; then
            return 0
        fi
    done
    return 1
}

# Function to format file paths for display (convert $HOME to ~)
format_path_for_display() {
    echo $1
}

# Function to display scan results with optional verbose file path
DISPLAYINFO() {
	local func_name="$1"
	local file_path="$2"
	local line_count=$(wc -l 2>/dev/null < "$file_path" || echo 0)
	
	if [[ "$VERBOSE" == true ]]; then
		local formatted_path=$(format_path_for_display "$file_path")
		echo -e "${BGREEN}[+] ${func_name}${RESET}: ${line_count}, ${TIME} seconds: ${formatted_path}" | unew -a $RESUMELOGFILE
	else
		echo -e "${BGREEN}[+] ${func_name}${RESET}: ${line_count}, ${TIME} seconds" | unew -a $RESUMELOGFILE
	fi
}

run() {
    local func="$1"
    if is_excluded "$func"; then
        echo -e "${YELLOW}[~] $func${RESET}: 0, ${TIME} seconds" | unew -a $RESUMELOGFILE
    else
        $func
    fi
}

# Function to handle CLEANUP on Ctrl+C
CLEANUP(){
    if [[ -n "$SPINNER_PID" ]]; then
        kill "$SPINNER_PID" 2>/dev/null
    fi
    exit 1
}
trap CLEANUP SIGINT

START_SPINNER(){
    processing="${1}"
    START_TIME=$(date +%s)
    BRAILLE_STYLE_SPINNER_CHARS=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    # SLASH_SPINNER_CHARS=("/" "-" "\\" "|")
    # ARC_SPINNER_CHARS=("◐" "◓" "◑" "◒")
    # CLASSIC_DOTS_SPINNER_CHARS=("⠂" "⠒" "⠐" "⠰" "⠴" "⠦" "⠖" "⠒")
    # ARROW_SPINNER_CHARS=("←" "↖" "↑" "↗" "→" "↘" "↓" "↙")
    # BOX_SPINNER_CHARS=("▖" "▘" "▝" "▗")
    # QUARTERS_SPINNER_CHARS=("◴" "◷" "◶" "◵")
    # CLOCK_SPINNER_CHARS=("🕛" "🕐" "🕑" "🕒" "🕓" "🕔" "🕕" "🕖" "🕗" "🕘" "🕙" "🕚")
    # EMOJI_SPINNER_CHARS=("🌑" "🌒" "🌓" "🌔" "🌕" "🌖" "🌗" "🌘")
    # TRAIL_SPINNER_CHARS=("⠁" "⠂" "⠄" "⠂")

    while true; do
    	ELAPSED=$(( $(date +%s) - START_TIME ))
        for char in "${BRAILLE_STYLE_SPINNER_CHARS[@]}"; do
            printf "${YELLOW}[${char}]${RESET} ${processing} ${CYAN}(${ELAPSED} seconds)${RESET} 🔎"
            printf "                                    \r"
            sleep 0.05
        done
    done &
    SPINNER_PID=$!
}

STOP_SPINNER(){
    kill "${SPINNER_PID}" 2>/dev/null
    TIME=$(( $(date +%s) - START_TIME ))
    return $TIME
}

	STARTED_AT=$(date +"%d-%m-%Y_%H:%M:%S")
	START_EPOCH=$(date +%s)
	
	echo -e "Using $CONFIG_PATH"
	echo -e "Saving all files in $UNIQUEDOMAINDIR"


