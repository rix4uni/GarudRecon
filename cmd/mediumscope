# Process domains based on input method
if [[ -n "$DOMAINS_LIST_FILE" ]]; then
    # Read domains from file into array, skipping empty lines and comments
    DOMAINS_ARRAY=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Trim whitespace
        line=$(echo "$line" | xargs)
        # Skip empty lines and comments (lines starting with #)
        if [[ -n "$line" && ! "$line" =~ ^[[:space:]]*# ]]; then
            DOMAINS_ARRAY+=("$line")
        fi
    done < "$DOMAINS_LIST_FILE"
    
    # Check if we have any domains
    if [[ ${#DOMAINS_ARRAY[@]} -eq 0 ]]; then
        echo "Error: No valid domains found in '$DOMAINS_LIST_FILE'"
        exit 1
    fi
    
    # Process each domain
    TOTAL_DOMAINS=${#DOMAINS_ARRAY[@]}
    CURRENT_DOMAIN=0
    
    for domain in "${DOMAINS_ARRAY[@]}"; do
        ((CURRENT_DOMAIN++))
        echo -e "${BGREEN}Processing [${CURRENT_DOMAIN}/${TOTAL_DOMAINS}]: ${domain}${RESET}"
        process_domain "$domain"
    done
else
    # Single domain processing (existing behavior)
    # If RESUME_MODE is true and TARGET is empty, try to extract domain from RESUME_TARGET
    if [[ "$RESUME_MODE" == true && -z "$TARGET" ]]; then
        # RESUME_TARGET is usually "domain.com" or "domain.com_1", extract domain part
        TARGET=$(echo "$RESUME_TARGET" | sed 's/_[0-9]*$//')
    fi
    process_domain "$TARGET"
fi
