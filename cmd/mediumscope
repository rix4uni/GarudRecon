	# Use httpx to check for broken links (4xx status codes)
	cat ${VULNDIR}/katana_links.txt | httpx -duc -silent -nc -sc -fr -t ${HTTPX_THREADS:-100} | grep -aE "\[4" | awk '{print $1}' | unew -el -t -q ${VULNDIR}/broken_links.txt

	# Check if the file has more than 0 lines
	if [ -f "${VULNDIR}/broken_links.txt" ] && [ $(wc -l < "${VULNDIR}/broken_links.txt") -gt 0 ]; then
	    cp "${VULNDIR}/broken_links.txt" "${ROOT_VULNDIR}/broken_links.txt"
	fi

	STOP_SPINNER
	echo -e "${BGREEN}[+] BROKEN_LINKS${RESET}: $(wc -l 2>/dev/null < ${ROOT_VULNDIR}/broken_links.txt || echo 0), ${TIME} seconds" | unew -a $RESUMELOGFILE
}


###############################################################################################################
####################################### URLS SECRETS #########################################################
###############################################################################################################
LINKINSPECTOR(){
	START_SPINNER "${BGREEN}LINKINSPECTOR${RESET}"

	cat ${ROOT_URLSDIR}/allurls.txt | linkinspector -silent -nc -append-output linkinspector.txt

	# Domain Backup Fuzz
	cat ${ROOT_SUBDOMAINDIR}/httpx.txt | awk -F' ' '{ if ($2 == "[403]" || $2 == "[404]" || $2 == "[302]") print $1 }' | unew -el -t -q ${SUBDOMAINDIR}/notaccessible_subs.txt
	cat ${SUBDOMAINDIR}/notaccessible_subs.txt | fuzzuli -sl -mt shuffle -jw | unew -el -t -q ${SUBDOMAINDIR}/fuzzuli.txt
	cat ${SUBDOMAINDIR}/fuzzuli.txt | linkinspector -silent -nc -mc 200,302 -append-output ${SUBDOMAINDIR}/fuzzuli_linkinspector.txt


	cat ${SUBDOMAINDIR}/notaccessible_subs.txt | wordgen -silent -path wordlists/words.txt -e ".rar, .zip, .tar.gz, .tar, .gz, .jar, .7z, .bz2, .sql, .backup, .war" | unew -el -t -q wordgen.txt
	cat wordgen.txt | linkinspector -silent -nc -mc 200,302 -append-output ${SUBDOMAINDIR}/fuzzuli_linkinspector.txt

	cat ${SUBDOMAINDIR}/notaccessible_subs.txt | interlace --silent -threads ${INTERLACE_THREADS} -c "ffuf -s -u _target_/FUZZ -w wordlists/onelistforallshort.txt -mc ${FFUFDIRENUM_STATUS_MATCH} -o _output_/_cleantarget_.json" -o ${SUBDOMAINDIR}/ffufdirenum

	STOP_SPINNER
	echo -e "${BGREEN}[+] LINKINSPECTOR${RESET}: $(wc -l 2>/dev/null < ${ROOT_VULNDIR}/linkinspector.txt || echo 0), ${TIME} seconds" | unew -a $RESUMELOGFILE
}


