			cat ${URLSDIR}/gf_xss.txt | xssrecon --silent --specialchar "<, >" --json | jq -r 'select(.reflected==true) | select(.count.allowed==2) | .baseurl' | unew -q ${VULNDIR}/xss_xssrecon.txt
