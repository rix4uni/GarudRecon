			cat ${URLSDIR}/filteredurls.txt | xssrecon --silent --specialchar "<, >" --json | jq -r 'select(.reflected==true) | select(.count.allowed==2) | .baseurl' | unew -q ${VULNDIR}/xss_xssrecon.txt
			cat ${VULNDIR}/xss_xssrecon.txt | pvreplace -silent -payload ${XSS_WORDLIST} -fuzzing-part param-value -fuzzing-type replace -fuzzing-mode single | unew -el -t -q ${VULNDIR}/xss_pvreplace.txt
		fi

		# Common steps for both TRUE and FALSE conditions
		cat ${VULNDIR}/xss_pvreplace.txt | xsschecker -nc -match 'rix4uni' -vuln -t ${XSSCHECKER_THREADS} -timeout ${XSSCHECKER_TIMEOUT} -retries ${XSSCHECKER_RETRIES} -filter | unew -el -t -q ${VULNDIR}/xsschecker.txt

