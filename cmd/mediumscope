	timelimitx -t ${CHAOS_TIMELIMITX} "chaos -duc -silent -d ${TARGET} -key $(shuf -n 1 ~/.config/chaos/chaos-api.txt) | unew -ef -el -i -t -q ${TMPDIR}/chaos.subs"

