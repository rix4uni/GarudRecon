	STOP_SPINNER
	DISPLAYINFO "SHOSUBGO" "${TMPDIR}/shosubgo.subs"
}

ORG2ASN(){
	START_SPINNER "${BGREEN}ORG2ASN${RESET}"

	if [ "$ORG2ASN_SCAN_MODE" = "NORMAL" ]; then
		timelimitx -t ${ORG2ASN_TIMELIMITX} "echo "$TARGET" | tldinfo --silent --extract domain | org2asn -silent | unew -ef -el -t -q ${TMPDIR}/org2asn.txt"
	fi

	if [ "$ORG2ASN_SCAN_MODE" = "ADVANCED" ]; then
		timelimitx -t ${ORG2ASN_TIMELIMITX} "echo "$TARGET" | tldinfo --silent --extract domain | org2asn -silent | unew | cut -d"[" -f5 | sed 's/]$//' | org2asn -silent | unew -ef -el -t -q ${TMPDIR}/org2asn.txt"
	fi

	# Common steps for both conditions
	sed -i 's/^[^]]*] //' ${TMPDIR}/org2asn.txt 2>/dev/null
	cat ${TMPDIR}/org2asn.txt 2>/dev/null | grep -oP '\[.*?\](?= \[ASN\])' | sed 's/^\[//' | sed 's/\]$//' | unew -ef -el -t -q ${TMPDIR}/asns.txt
	cat ${TMPDIR}/org2asn.txt 2>/dev/null | grep -oP '\[.*?\](?= \[Route\])' | sed 's/^\[//' | sed 's/\]$//' | unew -ef -el -t -q ${TMPDIR}/ips.txt
	cat ${TMPDIR}/org2asn.txt 2>/dev/null | grep -oP '(?<=\[ASN\] ).*' | sed 's/^\[//' | sed 's/\]$//' | unew -ef -el -t -q ${TMPDIR}/orgs.txt
	cat ${TMPDIR}/org2asn.txt 2>/dev/null | grep -oP '(?<=\[Route\] ).*' | sed 's/^\[//' | sed 's/\]$//' | unew -ef -el -t -q ${TMPDIR}/orgs.txt

	STOP_SPINNER
	DISPLAYINFO "ORG2ASN" "${TMPDIR}/org2asn.txt"
}

ARINRANGE(){
	START_SPINNER "${BGREEN}ARINRANGE${RESET}"

	timelimitx -t ${ARINRANGE_TIMELIMITX} "cat ${TMPDIR}/orgs.txt | arinrange --silent | mapcidr -silent -aggregate | unew -ef -el -t -q ${TMPDIR}/ips.txt"

