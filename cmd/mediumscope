	rm -rf $ROOT_WORDLISTDIR/resolvers.txt
	rm -rf $ROOT_WORDLISTDIR/stable_resolvers.txt

	wget -q -O $ROOT_WORDLISTDIR/resolvers.txt https://raw.githubusercontent.com/rix4uni/resolvers/refs/heads/main/resolvers.txt
