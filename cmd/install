# CONFIGS
CONFIGS() {
    START_SPINNER "${BGREEN}CONFIGS${RESET}"
    mkdir -p ~/.config/favinfo && curl -s "https://raw.githubusercontent.com/rix4uni/favinfo/refs/heads/main/fingerprint.json" >> ~/.config/favinfo/fingerprint.json
    mkdir -p ~/.config/waymore && curl -s "https://raw.githubusercontent.com/xnl-h4ck3r/waymore/refs/heads/main/config.yml" >> ~/.config/waymore/config.yml
    mkdir -p ~/.config/xnLinkFinder && curl -s "https://raw.githubusercontent.com/xnl-h4ck3r/xnLinkFinder/refs/heads/main/config.yml" >> ~/.config/xnLinkFinder/config.yml
    mkdir -p ~/.config/chaos && touch ~/.config/chaos/chaos-api.txt
    mkdir -p ~/.config/shosubgo && touch ~/.config/shosubgo/shosubgo-api.txt

    STOP_SPINNER
    log_message "${BGREEN}[+] CONFIGS - INSTALLED${RESET}: ${TIME} seconds"
}


# SOME DATA
TRICKESTCLOUD() {
    START_SPINNER "${BGREEN}TRICKESTCLOUD${RESET}"
    wget -q -O $WORDLIST_BASEDIR/trickestcloud.zip https://github.com/trickest/cloud/archive/refs/heads/main.zip
    unzip -q $WORDLIST_BASEDIR/trickestcloud.zip -d $WORDLIST_BASEDIR
    mv $WORDLIST_BASEDIR/cloud-main $WORDLIST_BASEDIR/trickestcloud
    cat $WORDLIST_BASEDIR/trickestcloud/ssl/ssl*.csv | cut -d"," -f2,7 | tr "|" "\n" | tr "," "\n" | sed 's/"//g' | unew -el -i -t -q $WORDLIST_BASEDIR/trickestcloud_ssl.txt

    rm -rf $WORDLIST_BASEDIR/trickestcloud.zip $WORDLIST_BASEDIR/trickestcloud

    STOP_SPINNER
    log_message "${BGREEN}[+] TRICKESTCLOUD - INSTALLED${RESET}: ${TIME} seconds"
}


# WORDLISTS
WORDLISTS() {
    START_SPINNER "${BGREEN}WORDLISTS${RESET}"
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/best-dns-wordlist.txt" | unew -el -t -q $WORDLIST_BASEDIR/best-dns-wordlist.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/2m-subdomains.txt" | unew -el -t -q $WORDLIST_BASEDIR/2m-subdomains.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/kiterunner/swagger-wordlist.txt" | unew -el -t -q $WORDLIST_BASEDIR/swagger-wordlist.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/technologies/swagger-ui/swagger-ui.txt" | unew -el -t -q $WORDLIST_BASEDIR/swagger-wordlist.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/asp_lowercase.txt" | unew -el -t -q $WORDLIST_BASEDIR/asp_lowercase.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/aspx_lowercase.txt" | unew -el -t -q $WORDLIST_BASEDIR/aspx_lowercase.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/bak.txt" | unew -el -t -q $WORDLIST_BASEDIR/bak.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/do.txt" | unew -el -t -q $WORDLIST_BASEDIR/do.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/jsp.txt" | unew -el -t -q $WORDLIST_BASEDIR/jsp.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/php.txt" | unew -el -t -q $WORDLIST_BASEDIR/php.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/phpmillion.txt" | unew -el -t -q $WORDLIST_BASEDIR/phpmillion.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/pl.txt" | unew -el -t -q $WORDLIST_BASEDIR/pl.txt
    curl -s "https://wordlists-cdn.assetnote.io/data/manual/xml_filenames.txt" | unew -el -t -q $WORDLIST_BASEDIR/xml_filenames.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/resolvers/refs/heads/main/resolvers.txt" | unew -el -t -q $WORDLIST_BASEDIR/resolvers.txt
    curl -s "https://raw.githubusercontent.com/trickest/resolvers/refs/heads/main/resolvers-trusted.txt" | unew -el -t -q $WORDLIST_BASEDIR/resolvers-trusted.txt
    curl -s "https://raw.githubusercontent.com/six2dez/OneListForAll/refs/heads/main/onelistforallshort.txt" | unew -el -t -q $WORDLIST_BASEDIR/onelistforallshort.txt
    curl -s "https://raw.githubusercontent.com/six2dez/OneListForAll/refs/heads/main/onelistforallmicro.txt" | unew -el -t -q $WORDLIST_BASEDIR/onelistforallmicro.txt
    curl -s "https://gist.github.com/six2dez/ffc2b14d283e8f8eff6ac83e20a3c4b4/raw" | unew -el -t -q $WORDLIST_BASEDIR/perms.txt
    curl -s "https://raw.githubusercontent.com/dwyl/english-words/refs/heads/master/words.txt" | unew -el -t -q $WORDLIST_BASEDIR/words.txt
    curl -s "https://raw.githubusercontent.com/dwyl/english-words/refs/heads/master/words_alpha.txt" | unew -el -t -q $WORDLIST_BASEDIR/words_alpha.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/ftpx/refs/heads/main/wordlists/ftp-username-password.txt" | unew -el -t -q $WORDLIST_BASEDIR/ftp-username-password.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/ftpx/refs/heads/main/wordlists/ftp-password.txt" | unew -el -t -q $WORDLIST_BASEDIR/ftp-password.txt
    curl -s "https://raw.githubusercontent.com/cujanovic/Virtual-host-wordlist/refs/heads/master/virtual-host-wordlist.txt" | unew -el -t -q $WORDLIST_BASEDIR/virtual-host-wordlist.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/payloads/xss/xss-small.txt" | unew -el -t -q $WORDLIST_BASEDIR/xss-small.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/payloads/xss/xss-medium.txt" | unew -el -t -q $WORDLIST_BASEDIR/xss-medium.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/payloads/xss/xss-large.txt" | unew -el -t -q $WORDLIST_BASEDIR/xss-large.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/payloads/lfi/lfi-small.txt" | unew -el -t -q $WORDLIST_BASEDIR/lfi-small.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/payloads/lfi/lfi-medium.txt" | unew -el -t -q $WORDLIST_BASEDIR/lfi-medium.txt
    curl -s "https://raw.githubusercontent.com/rix4uni/WordList/refs/heads/main/payloads/lfi/lfi-large.txt" | unew -el -t -q $WORDLIST_BASEDIR/lfi-large.txt


    rm -rf $WORDLIST_BASEDIR/top-subdomain-list && git clone https://github.com/jeancarlor/top-subdomain-list.git --depth 1 $WORDLIST_BASEDIR/top-subdomain-list &>/dev/null
    cat $WORDLIST_BASEDIR/top-subdomain-list/*.txt | unew -el -t -q $WORDLIST_BASEDIR/all_hostnames.txt
    rm -rf $WORDLIST_BASEDIR/top-subdomain-list

    rm -rf $WORDLIST_BASEDIR/n0kovo_subdomains && git clone https://github.com/n0kovo/n0kovo_subdomains.git --depth 1 $WORDLIST_BASEDIR/n0kovo_subdomains &>/dev/null
    mv $WORDLIST_BASEDIR/n0kovo_subdomains/*.txt $WORDLIST_BASEDIR
    rm -rf $WORDLIST_BASEDIR/n0kovo_subdomains

    STOP_SPINNER
    log_message "${BGREEN}[+] WORDLISTS - INSTALLED${RESET}: ${TIME} seconds"
}

