CHROME() {
    START_SPINNER "${BGREEN}CHROME${RESET}"
    
    wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -O /tmp/google-chrome-stable_current_amd64.deb
    dpkg -i /tmp/google-chrome-stable_current_amd64.deb &>/dev/null
    rm -rf /tmp/google-chrome-stable_current_amd64.deb
    apt -f install -y &>/dev/null
    
    # Ensure common chrome paths are checked
    export PATH="$PATH:/usr/bin:/usr/local/bin"
    
    # Check multiple possible locations for google-chrome
    local chrome_found=false
    if command -v google-chrome &>/dev/null; then
        chrome_found=true
    elif [[ -f "/usr/bin/google-chrome" ]] && [[ -x "/usr/bin/google-chrome" ]]; then
        chrome_found=true
        export PATH="$PATH:/usr/bin"
    elif [[ -f "/usr/bin/google-chrome-stable" ]] && [[ -x "/usr/bin/google-chrome-stable" ]]; then
        chrome_found=true
        export PATH="$PATH:/usr/bin"
    fi
    
    if [[ "$chrome_found" == false ]]; then
        log_message "${BRED}[x] CHROME - INSTALLATION FAILED${RESET}: ${TIME} seconds"
        STOP_SPINNER
        return
    fi
    
    STOP_SPINNER
    log_message "${BGREEN}[+] CHROME - INSTALLED${RESET}: ${TIME} seconds"
}

PIPX() {
    START_SPINNER "${BGREEN}PIPX${RESET}"
    
    apt install pipx -y &>/dev/null
    pipx ensurepath &>/dev/null
    
    # Ensure ~/.local/bin is in PATH immediately (pipx ensurepath updates ~/.bashrc but not current shell)
    export PATH="$HOME/.local/bin:$PATH"
    
    # Also check common pipx locations
    if [[ -d "$HOME/.local/bin" ]]; then
        export PATH="$HOME/.local/bin:$PATH"
    fi
    
    if ! command -v pipx &>/dev/null; then
        log_message "${BRED}[x] PIPX - INSTALLATION FAILED${RESET}: ${TIME} seconds"
        STOP_SPINNER
        return
    fi
    
    STOP_SPINNER
    log_message "${BGREEN}[+] PIPX - INSTALLED${RESET}: ${TIME} seconds"
}

