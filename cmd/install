# Dynamically call the selected function
$FUNC


ENDED_AT=$(date +"%d-%m-%Y_%H:%M:%S")
END_EPOCH=$(date +%s)

DURATION=$(( END_EPOCH - START_EPOCH ))
TIMETOOK=$(printf "%02d:%02d:%02d" $((DURATION/3600)) $(( (DURATION%3600)/60 )) $((DURATION%60)) )

log_message "${BGREEN}[+] STARTED${RESET}: ${STARTED_AT}, ${BGREEN}FINISHED${RESET}: ${ENDED_AT}, ${BGREEN}TIMETOOK${RESET}: ${TIMETOOK}"
