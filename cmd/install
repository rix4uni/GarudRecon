#!/bin/bash

# Default config file path
CONFIG_PATH="configuration/garudrecon.cfg"
USE_BINARY=true

# Help function
function show_help() {
  cat <<EOF
Install the tool and all required dependencies.
Runs setup tasks and installs any system or language packages your tool needs so you can start scanning immediately.

Usage:
  garudrecon install [flags]

Flags:
  -f, --function        Function to run (e.g. WORKFLOW)
  -c, --config          Custom configuration file path
  --no-binary           Build tools from source instead of using pre-built binaries
  -v, --verbose         enable verbose mode
  -h, --help            help for install

Example:
  garudrecon install -f ALL
  garudrecon install -f ALL --no-binary
EOF
}

# Check if no args
if [[ $# -eq 0 ]]; then
  show_help
  exit 0
fi

# Parse arguments
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -f|--function)
      if [[ -z "$2" || "$2" == -* ]]; then
        echo "Error: -f requires a valid function argument"
        exit 1
      fi

      FUNC="$2"
      shift 2
      ;;
    -c|--config)
      CONFIG_PATH="$2"
      shift 2
      ;;
    --no-binary)
      USE_BINARY=false
      shift
      ;;
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

# Load configuration - check both possible locations
if [[ -f "$CONFIG_PATH" ]]; then
    source "$CONFIG_PATH"
elif [[ -f "$HOME/.garudrecon/configuration/garudrecon.cfg" ]]; then
    source "$HOME/.garudrecon/configuration/garudrecon.cfg"
else
    echo "Error: Configuration file '$CONFIG_PATH' not found."
    exit 1
fi

PRINTBANNER

# Check root user
AREUROOTUSER

# Creating directories
mkdir -p wordlists

INSTALLEDLOGFILE="installed.log"

# Helper function to log messages (uses unew if available, otherwise tee)
log_message() {
    if command -v unew &>/dev/null; then
        echo -e "$1" | unew -a "$INSTALLEDLOGFILE"
    else
        echo -e "$1" >> "$INSTALLEDLOGFILE"
    fi
}

# Function to handle CLEANUP on Ctrl+C
CLEANUP() {
    if [[ -n "$SPINNER_PID" ]]; then
        kill "$SPINNER_PID" 2>/dev/null
    fi
    exit 1
}
trap CLEANUP SIGINT

START_SPINNER() {
    processing="${1}"
    START_TIME=$(date +%s)
    BRAILLE_STYLE_SPINNER_CHARS=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

    while true; do
        ELAPSED=$(( $(date +%s) - START_TIME ))
        for char in "${BRAILLE_STYLE_SPINNER_CHARS[@]}"; do
            printf "${YELLOW}[${char}]${RESET} ${processing} ${CYAN}(${ELAPSED} seconds)${RESET} 🔎"
            printf "                                    \r"
            sleep 0.05
        done
    done &
    SPINNER_PID=$!
}

STOP_SPINNER() {
    kill "${SPINNER_PID}" 2>/dev/null
    TIME=$(( $(date +%s) - START_TIME ))
    return $TIME
}

# Download and extract pre-built binaries
# This function downloads binaries once and extracts them to ~/go/bin/
download_binaries() {
    if [[ "$USE_BINARY" == false ]]; then
        return
    fi
    
    # Ensure ~/go/bin is in PATH for command -v checks
    export PATH="$PATH:$HOME/go/bin"
    
    # Always download fresh binaries (unless --no-binary flag is used)
    START_SPINNER "${BGREEN}DOWNLOADING PRE-BUILT BINARIES${RESET}"
    
    # Download the binary zip file
    wget -q https://github.com/rix4uni/GarudReconBinary/releases/download/nightly/GarudReconBinary.zip -O GarudReconBinary.zip
    
    if [[ ! -f GarudReconBinary.zip ]]; then
        STOP_SPINNER
        log_message "${YELLOW}[~] Binary download failed, will build from source${RESET}"
        USE_BINARY=false
        return
    fi
    
    # Create go/bin directory if it doesn't exist
    mkdir -p ~/go/bin
    
    # Unzip to ~/go/bin/
    unzip -q -j GarudReconBinary.zip -d ~/go/bin/ &>/dev/null
    
    # Clean up zip file
    rm -rf GarudReconBinary.zip
    
    STOP_SPINNER
    log_message "${BGREEN}[+] PRE-BUILT BINARIES DOWNLOADED${RESET}: ${TIME} seconds"
}

# Generic installation helper function
# Parameters:
#   $1: Tool display name (e.g., "SUBFINDER")
#   $2: Command name to check (e.g., "subfinder")
#   $3: Installation command to execute
#   $4: Optional - if "no-log", don't log to INSTALLEDLOGFILE
install_tool() {
    local tool_name="$1"
    local cmd_name="$2"
    local install_cmd="$3"
    local log_flag="${4:-log}"
    
    START_SPINNER "${BGREEN}${tool_name}${RESET}"
    
    eval "$install_cmd"
    
    # Ensure common bin directories are in PATH before checking
    export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/bin:/usr/bin:$PATH"
    
    # Check if tool exists - try multiple methods
    local tool_found=false
    
    # Method 1: Check via command -v
    if command -v "$cmd_name" &>/dev/null; then
        tool_found=true
    fi
    
    # Method 2: Check common installation locations
    if [[ "$tool_found" == false ]]; then
        local check_paths=(
            "$HOME/.local/bin/$cmd_name"
            "$HOME/go/bin/$cmd_name"
            "/usr/local/bin/$cmd_name"
            "/usr/bin/$cmd_name"
            "/opt/$cmd_name"
        )
        
        for path in "${check_paths[@]}"; do
            if [[ -f "$path" ]] && [[ -x "$path" ]]; then
                tool_found=true
                # Add the directory to PATH if not already there
                local tool_dir=$(dirname "$path")
                if [[ ":$PATH:" != *":$tool_dir:"* ]]; then
                    export PATH="$tool_dir:$PATH"
                fi
                break
            fi
        done
    fi
    
    if [[ "$tool_found" == false ]]; then
        if [[ "$log_flag" == "no-log" ]]; then
            echo -e "${BRED}[x] ${tool_name} - INSTALLATION FAILED${RESET}: ${TIME} seconds"
        else
            log_message "${BRED}[x] ${tool_name} - INSTALLATION FAILED${RESET}: ${TIME} seconds"
        fi
        STOP_SPINNER
        return
    fi
    
    STOP_SPINNER
    if [[ "$log_flag" == "no-log" ]]; then
        echo -e "${BGREEN}[+] ${tool_name} - INSTALLED${RESET}: ${TIME} seconds"
    else
        log_message "${BGREEN}[+] ${tool_name} - INSTALLED${RESET}: ${TIME} seconds"
    fi
}

# Helper for go install commands
# Parameters:
#   $1: Tool display name
#   $2: Command name
#   $3: Go package path (e.g., "github.com/rix4uni/unew@latest")
install_go_tool() {
    local tool_name="$1"
    local cmd_name="$2"
    local go_package="$3"
    install_tool "$tool_name" "$cmd_name" "go install ${go_package} &>/dev/null"
}

# Helper for gocl -i commands
# Parameters:
#   $1: Tool display name
#   $2: Command name
#   $3: Go package path (e.g., "github.com/projectdiscovery/subfinder")
#   $4: Optional additional gocl flags (e.g., "-c \"cmd/xsubfind3r\"")
install_gocl_tool() {
    local tool_name="$1"
    local cmd_name="$2"
    local go_package="$3"
    local extra_flags="${4:-}"
    
    # If --no-binary flag is set, use gocl -i method to build from source
    if [[ "$USE_BINARY" == false ]]; then
        if [[ -n "$extra_flags" ]]; then
            install_tool "$tool_name" "$cmd_name" "gocl -i ${go_package} ${extra_flags} &>/dev/null"
        else
            install_tool "$tool_name" "$cmd_name" "gocl -i ${go_package} &>/dev/null"
        fi
        return
    fi
    
    # Use binary installation (default)
    # Binaries are already downloaded by download_binaries(), just verify they exist
    # Check both file existence and command availability (more robust)
    if [[ -f "$HOME/go/bin/$cmd_name" ]] && [[ -x "$HOME/go/bin/$cmd_name" ]]; then
        # Tool already exists from binaries, skip installation
        log_message "${YELLOW}[~] ${tool_name} - ALREADY INSTALLED (from binaries)${RESET}"
        return
    fi
    
    # Also check via command -v in case PATH is set correctly
    if command -v "$cmd_name" &>/dev/null; then
        # Tool already exists from binaries, skip installation
        log_message "${YELLOW}[~] ${tool_name} - ALREADY INSTALLED (from binaries)${RESET}"
        return
    fi
    
    # Binary not found, fall back to building from source
    if [[ -n "$extra_flags" ]]; then
        install_tool "$tool_name" "$cmd_name" "gocl -i ${go_package} ${extra_flags} &>/dev/null"
    else
        install_tool "$tool_name" "$cmd_name" "gocl -i ${go_package} &>/dev/null"
    fi
}

# Helper for pip3 install commands
# Parameters:
#   $1: Tool display name
#   $2: Command name
#   $3: pip3 install arguments (e.g., "arjun --no-cache-dir --break-system-packages")
install_pip3_tool() {
    local tool_name="$1"
    local cmd_name="$2"
    local pip_args="$3"
    install_tool "$tool_name" "$cmd_name" "pip3 install ${pip_args} &>/dev/null"
}

# Helper for pipx install commands
# Parameters:
#   $1: Tool display name
#   $2: Command name
#   $3: pipx install arguments (e.g., "--force git+https://github.com/rix4uni/tldinfo.git")
install_pipx_tool() {
    local tool_name="$1"
    local cmd_name="$2"
    local pipx_args="$3"
    
    # Ensure pipx is available and ~/.local/bin is in PATH
    if ! command -v pipx &>/dev/null; then
        log_message "${BRED}[x] ${tool_name} - INSTALLATION FAILED (pipx not found)${RESET}"
        return
    fi
    
    # Ensure ~/.local/bin is in PATH (pipx installs tools here)
    export PATH="$HOME/.local/bin:$PATH"
    
    install_tool "$tool_name" "$cmd_name" "pipx install ${pipx_args} &>/dev/null"
}

# Helper for custom installation commands
# Parameters:
#   $1: Tool display name
#   $2: Command name
#   $3: Custom installation command (will be eval'd)
#   $4: Optional - if "no-log", don't log to INSTALLEDLOGFILE
install_custom_tool() {
    local tool_name="$1"
    local cmd_name="$2"
    local install_cmd="$3"
    local log_flag="${4:-log}"
    install_tool "$tool_name" "$cmd_name" "$install_cmd" "$log_flag"
}

STARTED_AT=$(date +"%d-%m-%Y_%H:%M:%S")
START_EPOCH=$(date +%s)

echo -e "Using $CONFIG_PATH"

# Download pre-built binaries if USE_BINARY is true
download_binaries

# Ensure ~/go/bin is in PATH globally after binaries are downloaded
# This is needed for install_gocl_tool() checks and subsequent tool usage
export PATH="$PATH:$HOME/go/bin"


# VARIABLES
VARIABLES() {
    START_SPINNER "${BGREEN}VARIABLES${RESET}"

    if ! grep -q "alias xc='xsel -i -b'" ~/.bashrc; then
        echo -e "\n# xsel Variable" >> ~/.bashrc
        echo -e "alias xc='xsel -i -b'" >> ~/.bashrc
        echo -e "alias xp='xsel -o -b'" >> ~/.bashrc
        echo -e "alias cfile='explorer.exe .'" >> ~/.bashrc
        echo -e "alias gs='garudrecon smallscope'" >> ~/.bashrc
        echo -e "alias gm='garudrecon mediumscope'" >> ~/.bashrc
        echo -e "alias gl='garudrecon largescope'" >> ~/.bashrc
        echo -e "alias gcidr='garudrecon cidrscope'" >> ~/.bashrc
        echo -e "alias gw='garudrecon workflow'" >> ~/.bashrc
        echo -e "alias gf='garudrecon fleet'" >> ~/.bashrc
        echo -e "alias gc='garudrecon cronjobs'" >> ~/.bashrc

        cat << 'EOF' >> ~/.bashrc
export PATH="$PATH:/usr/local/go/bin"
export PATH="$PATH:$HOME/go/bin"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/.cargo/bin"
export PATH="$PATH:/usr/bin/google-chrome"
export PATH=$HOME/.local/bin:$PATH
EOF
    fi

    # Add zoxide initialization if not already present
    if ! grep -q "zoxide init" ~/.bashrc; then
        cat << 'EOF' >> ~/.bashrc

# zoxide initialization
eval "$(zoxide init --cmd cd bash)"

zpath_add() {
  for base in "$@"; do
    find "$base" -type d -print0
  done | while IFS= read -r -d '' dir; do
    zoxide add "$dir"
    #echo "✅ Added: $dir"
  done
}

# zpath_add ~/.config ~/.garudrecon ~/some/other/path

zpath_remove() {
  zoxide query -l | grep -E "$1" | while read -r dir; do
    zoxide remove "$dir"
    #echo "❌ Removed: $dir"
  done
}

# zpath_remove "~/.config|~/.garudrecon|sourcemapper"
EOF
    fi

    # ✅ Apply PATH immediately for *this* script run
    export PATH="$PATH:/usr/local/go/bin"
    export PATH="$PATH:$HOME/go/bin"
    export PATH="$PATH:$HOME/.local/bin"
    export PATH="$PATH:$HOME/.cargo/bin"
    export PATH="$PATH:/usr/bin/google-chrome"
    export PATH="$HOME/go/bin:$PATH"
    export PATH=$HOME/.local/bin:$PATH

    # Cargo env (rustup)
    [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

    STOP_SPINNER
    echo -e "${BGREEN}[+] VARIABLES - SETUP${RESET}: ${TIME} seconds"
}

GO() {
    START_SPINNER "${BGREEN}GO${RESET}"

    # Remove broken Go installation
    sudo rm -rf /usr/local/go

    curl -s "https://gist.githubusercontent.com/rix4uni/c412ca956ea3bfa114bf4b615a9762bc/raw/11e3b54333b9760973a3dec5c5e71d9507971333/go.sh" | bash &>/dev/null && source ~/.bashrc
    go env &>/dev/null

    if ! command -v go &>/dev/null; then
        echo -e "${BRED}[x] GO - INSTALLATION FAILED${RESET}: ${TIME} seconds"
        STOP_SPINNER
        return
    fi

    STOP_SPINNER
    echo -e "${BGREEN}[+] GO - INSTALLED${RESET}: ${TIME} seconds"
}

UNEW() {
    install_go_tool "UNEW" "unew" "github.com/rix4uni/unew@latest"
}

UNEWFLUSH() {
    START_SPINNER "${BGREEN}UNEWFLUSH${RESET}"

    # This is unew flush version only for gungnir saves output immediately in a file.
    git clone https://github.com/rix4uni/unew.git --depth 1 unewflush &>/dev/null
    cd unewflush
    mv unew.go unewflush.go
    sed -i 's/unew/unewflush/' go.mod
    sed -i '/w\.WriteString(line + "\\n")/a \\t\t\t\t\tw.Flush() // Flush immediately after writing' unewflush.go
    go install &>/dev/null
    cd ..
    rm -rf unewflush

    if ! command -v unewflush &>/dev/null; then
        log_message "${BRED}[x] UNEWFLUSH - INSTALLATION FAILED${RESET}: ${TIME} seconds"
        STOP_SPINNER
        return
    fi

    STOP_SPINNER
    log_message "${BGREEN}[+] UNEWFLUSH - INSTALLED${RESET}: ${TIME} seconds"
}

# PACKAGES
PACKAGES() {
    START_SPINNER "${BGREEN}PACKAGES${RESET}"
    apt --fix-broken install -y &>/dev/null
    dpkg --configure -a &>/dev/null
    apt update -y &>/dev/null
    # apt upgrade -y &>/dev/null
    apt install -y autoconf automake libtool build-essential libssl-dev libpcre3-dev libpcap-dev rsync net-tools dmidecode python3 libudev-dev gcc git sshpass curl dos2unix wget zip xsel jq npm chromium cmake poppler-utils parallel cewl python3-shodan unzip ruby-dev zoxide &>/dev/null
    gem install wpscan &>/dev/null
    wget -q https://raw.githubusercontent.com/rix4uni/dotfiles/refs/heads/main/tmux/tmux-termius.conf -O ~/.tmux.conf

    STOP_SPINNER
    log_message "${BGREEN}[+] PACKAGES - INSTALLED${RESET}: ${TIME} seconds"
}

